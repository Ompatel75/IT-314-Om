# .dockerignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment and Secrets (Never bake into Docker image)
.env
.env.local
.env.*.local
*.pem
*.key

# Git & IDE
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation / Artifact scratch files not needed at runtime
scratch/
Backend/*.pdf
contributor_feature_report.md
